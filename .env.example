# MusicNX environment overrides. Copy to .env for local development.
# Nested settings use double underscore. Complex values (lists) use JSON.

# Path to the YAML config file (optional).
MUSICNX_CONFIG=config/config.yaml

MUSICNX_MODE=mock

# MUSICNX_SERVER__HOST=127.0.0.1
# MUSICNX_SERVER__PORT=8080

# MUSICNX_PATHS__DATA_DIR=var
# MUSICNX_PATHS__DATABASE=var/musicnx.db
# MUSICNX_PATHS__LIBRARY=var/library
# MUSICNX_PATHS__DOWNLOADS=var/downloads
# MUSICNX_PATHS__CACHE=var/cache

# MUSICNX_AUDIO__BACKEND=auto
# MUSICNX_AUDIO__MPV_PATH=mpv
# mpv IPC socket. Use the literal path here (e.g. /run/user/<uid>/musicnx/mpv.sock);
# systemd units pass %t/musicnx/mpv.sock instead of hardcoding the uid.
# MUSICNX_AUDIO__IPC_SOCKET=/run/user/<uid>/musicnx/mpv.sock

# MUSICNX_LOGGING__LEVEL=DEBUG
# MUSICNX_LOGGING__FILE=var/log/musicnx.log

# MUSICNX_PLAYER__DEFAULT_VOLUME=70
# MUSICNX_PLAYER__AUTOPLAY=true
# MUSICNX_PLAYER__POSITION_PERSIST_INTERVAL_S=7
# MUSICNX_PLAYER__POSITION_EVENT_HZ=2

# MUSICNX_SECURITY__ALLOWED_HOSTS=["localhost","127.0.0.1","::1","musicnx.local"]

# PIN for mutating endpoints. Leave unset to allow mutations from localhost only.
# PIN and session_secret are never logged or returned by the API.
# MUSICNX_SECURITY__PIN=1234
# MUSICNX_SECURITY__SESSION_SECRET=<random-long-string>
# MUSICNX_SECURITY__SESSION_TTL_S=604800

# Never commit real tokens. Yandex credentials live only in the backend token
# file with mode 0600 and are not passed through environment variables.
# MUSICNX_YANDEX__ENABLED=false
# MUSICNX_YANDEX__QUALITY=mp3
# MUSICNX_YANDEX__TOKEN_FILE=var/secrets/yandex_token.json
# MUSICNX_AUDIO__BROWSER_ZONE=false
